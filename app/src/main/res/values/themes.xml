<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Barky" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/barky_primary</item>
        <item name="colorPrimaryVariant">@color/barky_primary_dark</item>
        <item name="colorSecondary">@color/barky_secondary</item>
        <item name="colorOnPrimary">@color/barky_on_primary</item>
        <item name="colorOnSecondary">@color/barky_on_primary</item>
        <item name="android:colorBackground">@color/barky_background</item>
        <item name="colorSurface">@color/barky_surface</item>
        <item name="colorOnSurface">@color/barky_on_surface</item>
        <item name="android:statusBarColor">@color/barky_primary_dark</item>
        <item name="android:navigationBarColor">@color/barky_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@drawable/bg_violet_pulse_window</item>
        <item name="materialButtonStyle">@style/Widget.Barky.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Barky.Card</item>
    </style>

    <style name="Widget.Barky.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/barky_primary</item>
        <item name="android:textColor">@color/barky_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">2dp</item>
    </style>

    <style name="Widget.Barky.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/barky_primary_light</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/barky_on_surface</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Barky.Button.Accent" parent="Widget.Barky.Button">
        <item name="backgroundTint">@color/barky_secondary</item>
        <item name="cornerRadius">20dp</item>
    </style>

    <style name="Widget.Barky.Button.Glass" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">20dp</item>
        <item name="backgroundTint">@color/barky_surface_elevated</item>
        <item name="android:textColor">@color/barky_on_surface</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="strokeColor">@color/barky_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Barky.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/barky_surface</item>
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">@color/barky_card_stroke</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Compact single-line title: "Barky  5.2 · 07-17 15:14" -->
    <style name="TextAppearance.Barky.Toolbar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/barky_on_surface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
</resources>
