<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Barky" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/barky_primary</item>
        <item name="colorPrimaryVariant">@color/barky_primary_dark</item>
        <item name="colorSecondary">@color/barky_secondary</item>
        <item name="colorOnPrimary">@color/barky_on_primary</item>
        <item name="colorOnSecondary">@color/barky_on_primary</item>
        <item name="android:colorBackground">@color/barky_background</item>
        <item name="colorSurface">@color/barky_surface</item>
        <item name="colorOnSurface">@color/barky_on_surface</item>
        <item name="android:statusBarColor">@color/barky_primary_dark</item>
        <item name="android:navigationBarColor">@color/barky_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/barky_background</item>
        <item name="materialButtonStyle">@style/Widget.Barky.Button</item>
    </style>

    <style name="Widget.Barky.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/barky_primary</item>
        <item name="android:textColor">@color/barky_on_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Barky.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/barky_primary</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/barky_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
