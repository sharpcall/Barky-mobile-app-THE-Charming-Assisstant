<?xml version="1.0" encoding="utf-8"?>
<!-- WhatsApp-like shell: video/map stage + multi-action footer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/barky_background"
    android:fitsSystemWindows="true">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/barky_primary"
        android:elevation="4dp"
        app:title="@string/app_name"
        app:titleTextColor="@color/barky_on_primary"
        app:subtitleTextColor="#B3FFFFFF" />

    <!-- Full chat stage: camera / remote video / GPS map -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0B141A">

        <TextureView
            android:id="@+id/walkie_preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/walkie_video"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/walkie_video_desc"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <WebView
            android:id="@+id/walkie_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/walkie_video_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="@string/walkie_video_placeholder"
            android:textColor="@color/barky_on_surface_muted"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="12dp"
            android:background="@drawable/bg_status_chip"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView
                android:id="@+id/walkie_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:text="@string/walkie_status_connecting"
                android:textColor="@color/barky_on_surface"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/walkie_peers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:maxLines="1"
                android:text="@string/walkie_peers_searching"
                android:textColor="@color/barky_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/walkie_flip_camera"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="@drawable/bg_flip_camera_circle"
            android:contentDescription="@string/walkie_flip_camera"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_flip_camera" />

        <TextView
            android:id="@+id/walkie_lock_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_status_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="@string/walkie_swipe_lock_hint"
            android:textColor="@color/barky_on_surface_muted"
            android:textSize="11sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/walkie_replay"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:enabled="false"
            android:minWidth="132dp"
            android:minHeight="48dp"
            android:text="@string/walkie_replay"
            android:textAllCaps="false"
            android:textColor="@color/barky_on_primary"
            app:backgroundTint="#CC075E54"
            app:cornerRadius="24dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconTint="@color/barky_on_primary" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/barky_surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/internet_pair_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/barky_surface_elevated"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/walkie_internet_title"
                    android:textColor="@color/barky_on_surface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/my_invite_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/walkie_my_code_waiting"
                    android:textColor="@color/barky_on_surface_muted"
                    android:textIsSelectable="true"
                    android:textSize="11sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/walkie_peer_code_hint"
                    app:boxBackgroundMode="outline"
                    app:boxStrokeColor="@color/barky_primary_light"
                    app:hintTextColor="@color/barky_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/peer_invite_edit"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword"
                        android:maxLines="1"
                        android:textColor="@color/barky_on_surface"
                        android:textSize="12sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/connect_invite"
                    style="@style/Widget.Barky.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:minHeight="40dp"
                    android:text="@string/walkie_connect_invite"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/walkie_best_quality"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:buttonTint="@color/barky_secondary"
                android:minHeight="36dp"
                android:text="@string/walkie_best_quality"
                android:textColor="@color/barky_on_surface_muted"
                android:textSize="11sp" />

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/walkie_gps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="@color/barky_accent"
                android:minHeight="36dp"
                android:text="@string/walkie_gps"
                android:textColor="@color/barky_on_surface_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- LISTEN + SEE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walkie_listen"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/walkie_listen"
                android:textAllCaps="false"
                android:textColor="@color/barky_on_surface"
                android:textSize="12sp"
                app:cornerRadius="22dp"
                app:strokeColor="@color/barky_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walkie_see"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/walkie_see"
                android:textAllCaps="false"
                android:textColor="@color/barky_on_surface"
                android:textSize="12sp"
                app:cornerRadius="22dp"
                app:strokeColor="@color/barky_accent" />
        </LinearLayout>

        <!-- WAKEUP left · classic round mic HOLD (WA-style drag) right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/walkie_wakeup"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/walkie_wakeup"
                android:textAllCaps="false"
                android:textColor="@color/barky_on_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@color/walkie_wakeup"
                app:cornerRadius="28dp" />

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp">

                <ImageButton
                    android:id="@+id/walkie_mic"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/bg_mic_circle"
                    android:contentDescription="@string/walkie_mic_desc"
                    android:elevation="6dp"
                    android:enabled="false"
                    android:padding="18dp"
                    android:scaleType="centerInside"
                    android:src="@android:drawable/ic_btn_speak_now"
                    android:tint="@color/barky_on_primary" />
            </FrameLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/walkie_mic_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingEnd="8dp"
            android:paddingTop="4dp"
            android:text="@string/walkie_mic_hint"
            android:textColor="@color/barky_on_surface_muted"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>

    <!-- Blocks the whole app until every required permission is granted -->
    <FrameLayout
        android:id="@+id/permission_gate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F00B141A"
        android:clickable="true"
        android:elevation="24dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/walkie_perm_gate_title"
                android:textColor="@color/barky_on_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permission_gate_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="start"
                android:lineSpacingExtra="4dp"
                android:textColor="@color/barky_on_surface_muted"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/permission_gate_btn"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/walkie_perm_gate_action"
                android:textAllCaps="false"
                app:backgroundTint="@color/barky_secondary"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
