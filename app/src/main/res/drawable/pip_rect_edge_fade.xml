<?xml version="1.0" encoding="utf-8"?>
<!-- Soft rectangular perimeter fade (keeps square corners, blends all four edges). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Top edge -->
    <item
        android:height="22dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00000000"
                android:startColor="#A60B141A" />
        </shape>
    </item>
    <!-- Bottom edge -->
    <item
        android:height="22dp"
        android:gravity="bottom">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="#00000000"
                android:startColor="#A60B141A" />
        </shape>
    </item>
    <!-- Left edge -->
    <item
        android:width="22dp"
        android:gravity="start">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#00000000"
                android:startColor="#A60B141A" />
        </shape>
    </item>
    <!-- Right edge -->
    <item
        android:width="22dp"
        android:gravity="end">
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:endColor="#00000000"
                android:startColor="#A60B141A" />
        </shape>
    </item>
</layer-list>
