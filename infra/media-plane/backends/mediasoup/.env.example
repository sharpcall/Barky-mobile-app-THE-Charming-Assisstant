# Signaling HTTP + WebSocket
HOST=0.0.0.0
PORT=3000

# Announced IP for mediasoup ICE candidates (public or LAN IP phones can reach).
# On Oracle Ampere use the instance public IP (or private if only VPN).
MEDIASOUP_ANNOUNCED_IP=

# RTC UDP port range for WebRtcTransport (open in cloud firewall / security list)
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40100

# Number of mediasoup workers (default 1; fine for small tests)
MEDIASOUP_NUM_WORKERS=1

# Log level: debug | warn | error | none
LOG_LEVEL=warn

# --- ICE / TURN (coturn is separate: infra/oracle-coturn) ---
# Comma-separated URLs, e.g.:
# TURN_URLS=stun:1.2.3.4:3478,turn:1.2.3.4:3478?transport=udp,turn:1.2.3.4:3478?transport=tcp
TURN_URLS=
TURN_USER=
TURN_PASS=
