# Built application files
*.apk
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
**/build/

# Local configuration (SDK path)
local.properties

# Local secrets — never commit (GitHub token, etc.)
.github_token
.github_push.env
*.token
secrets/
**/oci.env
*.pem
# Firebase: keep real google-services + SA keys local (example file is OK to commit)
app/google-services.json
**/firebase-service-account*.json
**/serviceAccount*.json

# Oracle coturn / Terraform local state and generated vars
**/terraform.tfstate
**/terraform.tfstate.*
**/terraform.tfvars
**/.terraform/
**/.terraform.lock.hcl
**/crash.log
**/turn-ice.generated.env

# Per-machine wireless adb endpoints (copy from devices-wifi.example.json)
scripts/devices-wifi.json

# Proguard
proguard/

# Log Files
*.log

# Android Studio
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Keystore — never commit secrets
*.jks
*.keystore
keystore.properties

# OS
.DS_Store
Thumbs.db

# Kotlin
.kotlin/

# External build root intermediates (if present under project)
build-outputs/*.apk
!build-outputs/.gitkeep

# Optional local tooling
*.hprof
.cxx/

# media-plane (Node SFU backends)
infra/media-plane/**/node_modules/
infra/media-plane/**/.env
!infra/media-plane/**/.env.example
